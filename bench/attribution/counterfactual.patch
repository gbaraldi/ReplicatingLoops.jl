+mutable struct Worker
+    @atomic job::Any
+    const pad::NTuple{15,Int}
+end
+const WORKERS = Worker[]
+const NEXTW = Threads.Atomic{Int}(0)
+function give_job!(r::Loop, i::Int)
+    nw = length(WORKERS)
+    nw == 0 && return false
+    s = NEXTW[]
+    for k in 1:nw
+        w = WORKERS[mod1(s + k, nw)]
+        if (@atomic :monotonic w.job) === nothing && (@atomicreplace w.job nothing => (r, i)).success
+            NEXTW[] = s + k
+            return true
+        end
+    end
+    return false
+end
+function bcast_loop(stop::Threads.Atomic{Bool})
+    seen = nothing
+    while !stop[]
+        r = @atomic :acquire CURRENT.loop
+        if r === nothing || r === seen
+            ccall(:jl_cpu_pause, Cvoid, ())
+            GC.safepoint()
+            continue
+        end
+        seen = r
+        r = r::Loop
+        h = @atomic r.helpers += 1
+        h <= r.maxhelpers || continue
+        Base.invokelatest(helper!, r, h)
+    end
+end
+function start_bcast!(stop)
+    for tid in Threads.threadpooltids(:default)
+        t = Task(() -> bcast_loop(stop))
+        t.sticky = true
+        ccall(:jl_set_task_tid, Cint, (Any, Cint), t, tid - 1)
+        schedule(t)
+    end
+end
+function worker_loop(w::Worker, stop::Threads.Atomic{Bool})
+    while !stop[]
+        job = @atomic :acquire w.job
+        if job === nothing
+            ccall(:jl_cpu_pause, Cvoid, ())
+            GC.safepoint()
+            continue
+        end
+        Base.invokelatest(helper!, job[1]::Loop, job[2]::Int)
+        @atomic :release w.job = nothing
+    end
+end
+# Start one spinning worker per default thread (sticky), for the counterfactual.
+function start_workers!(stop)
+    for tid in Threads.threadpooltids(:default)
+        w = Worker(nothing, ntuple(_ -> 0, 15))
+        push!(WORKERS, w)
+        t = Task(() -> worker_loop(w, stop))
+        t.sticky = true
+        ccall(:jl_set_task_tid, Cint, (Any, Cint), t, tid - 1)
+        schedule(t)
+    end
+end
